{
  "name": "content-engine",
  "version": "0.2.0",
  "type": "module",
  "description": "Multi-site AI blog content generation engine",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node main.js",
    "dev": "node --watch main.js",
    "smoke": "node scripts/smoke-test.js",
    "build-release": "node scripts/build-release.js",
    "start:windows": "powershell -ExecutionPolicy Bypass -File scripts/start-windows.ps1",
    "desktop": "electron desktop/main.cjs",
    "pack:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "express": "^4.18.2",
    "exceljs": "^4.4.0",
    "csv-parse": "^5.5.3",
    "csv-stringify": "^6.4.5",
    "archiver": "^6.0.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.content-engine-lite",
    "productName": "Content Engine Lite",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "desktop/**/*",
      "engine/**/*",
      "ui/**/*",
      "templates/**/*",
      "examples/demo-site/**/*",
      "docs/**/*",
      "scripts/**/*",
      ".env.example",
      "README.md",
      "VERSION",
      "CHANGELOG.md",
      "RELEASE-CHECKLIST.md",
      "SECURITY-CHECK.md",
      "package.json",
      "package-lock.json",
      "!sites/**/*",
      "!release/**/*",
      "!runtime/**/*",
      "!logs/**/*",
      "!site-recycle-bin/**/*",
      "!dist/**/*",
      "!server.out.log",
      "!server.err.log",
      "!**/.env",
      "!**/.env.*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Content-Engine-Lite-${version}-${arch}.${ext}"
    }
  }
}
